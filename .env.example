# ==============================================================================
# RESEARCH API KEYS (Tùy chọn - Dùng cho ExploreX Webapp tìm kiếm bài báo)
# Copy file này thành .env và điền các khóa API của bạn.
# File .env đã được cấu hình trong .gitignore, tuyệt đối không commit lên Git.
# ==============================================================================

# --- Tier 0: KHUYẾN NGHỊ (Chỉ cần email, không cần đăng ký) ---
# Dùng cho OpenAlex & CrossRef "polite pool" để tăng tốc độ và tránh bị giới hạn request rate
RESEARCH_EMAIL=your-email@domain.com

# --- Tier 1: NÊN CÓ (Đăng ký miễn phí) ---
# PubMed / NCBI - Ưu tiên hàng đầu cho các bài báo y sinh
PUBMED_API_KEY=

# Semantic Scholar - Cung cấp đồ thị trích dẫn và TLDR
SEMANTIC_SCHOLAR_API_KEY=

# CORE - Tìm kiếm các bản toàn văn Open Access hợp pháp
CORE_API_KEY=

# --- Tier 2: TÙY CHỌN BỔ SUNG ---
# Springer Nature API
SPRINGER_API_KEY=

# IEEE Xplore API
IEEE_API_KEY=
